              },
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "Why DuckDB, not Postgres? ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10.5pt",
                      "color": "#38BDF8",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "No server to run, embedded columnar format, reads Parquet directly, sub-second analytical window functions.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#94A3B8"
                    }
                  }
                ]
              },
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "Why pre-aggregate, not query live? ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10.5pt",
                      "color": "#38BDF8",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "1.5M crash rows will not filter interactively in a browser. Stages 4 and 5 run once in about 5 seconds; the dashboards read the cubes instantly.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#94A3B8"
                    }
                  }
                ]
              },
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "No Airflow: ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10.5pt",
                      "color": "#38BDF8",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "sequential Python scripts (01_ to 04_) keep the pipeline reproducible and easy to defend in review.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#94A3B8"
                    }
                  }
