table SimSpeed
	lineageTag: 9ed86691-f6d8-4dd9-941b-17dc2dafbffa

	column 'Speed Limit (mph)'
		dataType: int64
		formatString: 0
		lineageTag: 8d8adf45-ad3b-4db1-8aa4-bf47918db7ad
		summarizeBy: none
		sourceColumn: Speed Limit (mph)

		annotation SummarizationSetBy = User

	partition SimSpeed = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "SimSpeed.csv"),[Delimiter=",", Columns=1, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers,{{"Speed Limit (mph)", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
