table _Measures
	lineageTag: 5bd1e13d-1352-44a4-8f74-f1efcc88256f

	measure 'Total Crashes' = SUM(Segments[Crashes])
		formatString: #,0
		displayFolder: Segments
		lineageTag: cc6946f3-7bd1-4b34-a1d7-b795935b8764

	measure 'Network Exposure (MVKM)' = SUM(Segments[Exposure MVKM])
		formatString: #,0.0
		displayFolder: Segments
		lineageTag: 0a3ea4c9-bf09-489c-b4f8-d4e88cad7b68

	measure 'Lethal Trap Segments' = COALESCE(CALCULATE(COUNTROWS(Segments), LEFT(Segments[Quadrant], 2) = "Q2"), 0)
		formatString: #,0
		displayFolder: Segments
		lineageTag: f46569e0-a74b-4edd-92ea-898e9aecf7d8

	measure 'Total Fatalities' = SUM(Segments[Fatal])
		formatString: #,0
		displayFolder: Segments
		lineageTag: cac334d3-593a-4c1e-9841-4cef48e02230

	measure 'Total Serious Injuries' = SUM(Segments[Serious])
		formatString: #,0
		displayFolder: Segments
		lineageTag: e21f730e-31e6-49ee-9956-a47a9e646a98

	measure 'Mean Exposure Risk' = AVERAGE(Segments[Risk per MVKM])
		formatString: 0.0
		displayFolder: Segments
		lineageTag: 7a1f6329-4659-4200-894e-2a936fba077a

	measure 'Segment Count' = COUNTROWS(Segments)
		formatString: #,0
		displayFolder: Segments
		lineageTag: 761ff539-e5b3-4ec8-bea5-3c0f05b0f3c8

	measure 'Fatality Share %' = DIVIDE([Total Fatalities], [Total Crashes])
		formatString: 0.0%
		displayFolder: Segments
		lineageTag: 6ba4c59e-ed8c-4597-b14a-04fc7ed970d9

	measure 'Mean Exposure per Segment' = AVERAGE(Segments[Exposure MVKM])
		formatString: #,0.00
		displayFolder: Segments
		lineageTag: e579651f-bd68-47d7-9475-e26bff2d770c

	measure 'Raw Incidents' = SUM(Hourly[Crashes])
		formatString: #,0
		displayFolder: Temporal
		lineageTag: 7d3c61ea-2a44-4aae-ad9b-8e6de59f8401

	measure 'Raw Incidents Label' = FORMAT([Raw Incidents], "#,0") & " raw incidents"
		displayFolder: Labels
		lineageTag: f18a2bea-4dba-4912-8add-f43f4f4429b2

	measure 'Exposure Label' = "Million vehicle-km (MVKM)"
		displayFolder: Labels
		lineageTag: b358b43e-e26d-4867-bfa5-e2fad390dcbe

	measure 'Trap Label' = "Low count, severe risk"
		displayFolder: Labels
		lineageTag: 4aa103bf-2594-4d8b-bad9-aa432d81443a

	measure 'Fatal Label' = "Weight: 50x per DfT"
		displayFolder: Labels
		lineageTag: 4bf3e698-a589-452e-801e-38c6dad0b7b0

	measure 'Risk Label' = "Severity weight / MVKM"
		displayFolder: Labels
		lineageTag: 3e54fb77-ed71-4dec-9585-4954f0cabc75

	measure 'Raw Rank' = MIN(Segments[Raw Count Rank])
		formatString: #,0
		displayFolder: Segments
		lineageTag: 1d06cd4c-f30c-4736-b815-4f3d3652a7c0

	measure 'Risk Rank' = MIN(Segments[Exposure Risk Rank])
		formatString: #,0
		displayFolder: Segments
		lineageTag: 1fab68bd-abd8-478f-bf5a-f07391bd6d15

	measure 'Rank Shift' = SUM(Segments[Rank Shift])
		formatString: +#,0;-#,0;0
		displayFolder: Segments
		lineageTag: c055418b-d223-474a-a13d-2e79eba6999f

	measure 'Bench Crashes' = IF(MAX(Segments[Is Benchmark]) = 1, CALCULATE([Total Crashes], REMOVEFILTERS(Segments[Road Class]), REMOVEFILTERS(Segments[Suppression])))
		formatString: #,0
		displayFolder: Benchmark
		lineageTag: 8e5a7ed0-f634-4259-8809-79961420ec81

	measure 'Bench Raw Rank' = IF(MAX(Segments[Is Benchmark]) = 1, CALCULATE([Raw Rank], REMOVEFILTERS(Segments[Road Class]), REMOVEFILTERS(Segments[Suppression])))
		formatString: #,0
		displayFolder: Benchmark
		lineageTag: 21f6d73d-a20e-40d7-aa37-2ebd6fc9ad61

	measure 'Bench Exposure' = IF(MAX(Segments[Is Benchmark]) = 1, CALCULATE([Network Exposure (MVKM)], REMOVEFILTERS(Segments[Road Class]), REMOVEFILTERS(Segments[Suppression])))
		formatString: #,0.00
		displayFolder: Benchmark
		lineageTag: 3fa2f84b-e2da-48af-9654-8cdc3b6b02f1

	measure 'Bench Risk' = IF(MAX(Segments[Is Benchmark]) = 1, CALCULATE([Mean Exposure Risk], REMOVEFILTERS(Segments[Road Class]), REMOVEFILTERS(Segments[Suppression])))
		formatString: 0.00
		displayFolder: Benchmark
		lineageTag: 5464927a-9aef-4e55-8b95-2f235a60f56e

	measure 'Bench Risk Rank' = IF(MAX(Segments[Is Benchmark]) = 1, CALCULATE([Risk Rank], REMOVEFILTERS(Segments[Road Class]), REMOVEFILTERS(Segments[Suppression])))
		formatString: #,0
		displayFolder: Benchmark
		lineageTag: 2e29a3af-9331-4dbc-9d0b-29e3efb54d32

	measure 'Bench AADT' = IF(MAX(Segments[Is Benchmark]) = 1, CALCULATE(SUM(Segments[AADT]), REMOVEFILTERS(Segments[Road Class]), REMOVEFILTERS(Segments[Suppression])))
		formatString: #,0
		displayFolder: Benchmark
		lineageTag: 60a6ba44-d7d9-4b26-a442-cdfe51a922f9

	measure 'Benchmark Headline' = VAR tc = CALCULATE([Total Crashes], Segments[Benchmark Role] = "Hidden high risk", REMOVEFILTERS(Segments[Road Class]), REMOVEFILTERS(Segments[Suppression])) VAR sc = CALCULATE([Total Crashes], Segments[Benchmark Role] = "High count, ranks safe", REMOVEFILTERS(Segments[Road Class]), REMOVEFILTERS(Segments[Suppression])) VAR tr = CALCULATE([Mean Exposure Risk], Segments[Benchmark Role] = "Hidden high risk", REMOVEFILTERS(Segments[Road Class]), REMOVEFILTERS(Segments[Suppression])) VAR sr = CALCULATE([Mean Exposure Risk], Segments[Benchmark Role] = "High count, ranks safe", REMOVEFILTERS(Segments[Road Class]), REMOVEFILTERS(Segments[Suppression])) RETURN IF(HASONEVALUE('StudyContext'[Study Context]), FORMAT(DIVIDE(tc, sc), "0.00") & "x the crashes  ·  " & FORMAT(DIVIDE(tr, sr), "0.0") & "x the risk", "Select one study context")
		displayFolder: Benchmark
		lineageTag: c8b6afa4-84e0-48c2-82b8-e678268ec0cd

	measure 'Hourly Crashes' = SUM(Hourly[Crashes])
		formatString: #,0
		displayFolder: Temporal
		lineageTag: ce7d3640-a67b-4593-b62f-7b8bdd021247

	measure 'Hourly Fatality Rate' = DIVIDE(SUM(Hourly[Fatal]), SUM(Hourly[Crashes]))
		formatString: 0.0%
		displayFolder: Temporal
		lineageTag: e8304681-1d6b-45a5-89dd-09c7bd761f40

	measure 'Night Fatality Rate' = CALCULATE([Hourly Fatality Rate], Hourly[Hour] < 6 || Hourly[Hour] > 19)
		formatString: 0.0%
		displayFolder: Temporal
		lineageTag: c4ecfa80-a5e0-4cb3-af95-ed84bdf8f2e4

	measure 'Day Fatality Rate' = CALCULATE([Hourly Fatality Rate], Hourly[Hour] >= 6 && Hourly[Hour] <= 19)
		formatString: 0.0%
		displayFolder: Temporal
		lineageTag: 659926cf-aa00-4e97-af11-4e44cb3228a0

	measure 'Night vs Day Label' = "vs " & FORMAT([Day Fatality Rate], "0.0%") & " by day (06:00-19:59)"
		displayFolder: Labels
		lineageTag: efdbd9af-21a4-4f82-99ec-104b297a7369

	measure 'Peak Volume Hour' = VAR t = TOPN(1, VALUES(Hourly[Hour]), [Hourly Crashes], DESC) RETURN FORMAT(MAXX(t, Hourly[Hour]), "00") & ":00"
		displayFolder: Temporal
		lineageTag: 6e445a62-91a0-49ac-8718-4c18366e7474

	measure 'Peak Volume Label' = VAR t = TOPN(1, VALUES(Hourly[Hour]), [Hourly Crashes], DESC) RETURN FORMAT(MAXX(t, [Hourly Crashes]), "#,0") & " crashes in that hour"
		displayFolder: Labels
		lineageTag: 4d3ef3ac-c720-4529-9bf0-2c384d0f8cd1

	measure 'Most Lethal Hour' = VAR t = TOPN(1, VALUES(Hourly[Hour]), [Hourly Fatality Rate], DESC) RETURN FORMAT(MAXX(t, Hourly[Hour]), "00") & ":00"
		displayFolder: Temporal
		lineageTag: 55941a42-f0d8-496d-a258-bc89266ae24a

	measure 'Most Lethal Label' = VAR t = TOPN(1, VALUES(Hourly[Hour]), [Hourly Fatality Rate], DESC) RETURN "fatality share " & FORMAT(MAXX(t, [Hourly Fatality Rate]), "0.0%")
		displayFolder: Labels
		lineageTag: 7f069a81-ebdb-4522-b39e-1381fb2db5ab

	measure 'VRU Share' = DIVIDE(SUM(Hourly[VRU Crashes]), SUM(Hourly[Crashes]))
		formatString: 0%
		displayFolder: Temporal
		lineageTag: 9582259a-9bd4-4a0c-9f32-96393dd3a666

	measure 'VRU Label' = "two-wheelers, cyclists & pedestrians"
		displayFolder: Labels
		lineageTag: b52ecbd2-4499-4f92-b81b-7e27a436864a

	measure 'Severe Outcome Rate' = DIVIDE(SUM(Heatmap[Fatal]) + SUM(Heatmap[Serious]), SUM(Heatmap[Crashes]))
		formatString: 0%
		displayFolder: Temporal
		lineageTag: caed6bde-8e08-4c6f-9eb9-81aea3e50cc5

	measure 'Heatmap Colour' = VAR v = [Severe Outcome Rate] VAR hmGrid = ALLSELECTED(Heatmap[Day], Heatmap[Day Order], Heatmap[Hour]) VAR mn = MINX(hmGrid, [Severe Outcome Rate]) VAR mx = MAXX(hmGrid, [Severe Outcome Rate]) VAR t = DIVIDE(v - mn, mx - mn) RETURN IF(ISBLANK(v), BLANK(), SWITCH(TRUE(), t < 0.15, "#1B0C41", t < 0.3, "#4A0C6B", t < 0.45, "#781C6D", t < 0.6, "#A52C60", t < 0.75, "#CF4446", t < 0.9, "#ED6925", "#FBB61A"))
		displayFolder: Temporal
		lineageTag: a4947d75-d5bf-455b-9f7f-b85a2c1bd13c

	measure 'Env Crashes' = SUM(Environment[Crashes])
		formatString: #,0
		displayFolder: Conditions
		lineageTag: d5ec02f8-1925-4ae0-8ad1-1ec7fe485203

	measure 'Severe Outcome %' = DIVIDE(SUM(Environment[Fatal]) + SUM(Environment[Serious]), SUM(Environment[Crashes]))
		formatString: 0.0%
		displayFolder: Conditions
		lineageTag: de8ea15b-6be8-42d9-90d1-b5614de7c00e

	measure 'Env Fatality Rate' = DIVIDE(SUM(Environment[Fatal]), SUM(Environment[Crashes]))
		formatString: 0.0%
		displayFolder: Conditions
		lineageTag: 39be8808-09a9-4875-a30f-c2d2fdaea473

	measure 'Env Mean Severity Weight' = DIVIDE(SUMX(Environment, Environment[Mean Severity Weight] * Environment[Crashes]), SUM(Environment[Crashes]))
		formatString: 0.00
		displayFolder: Conditions
		lineageTag: df8730f9-69b5-49a5-99c8-b934a439c965

	measure 'Vehicle Severe Rate' = DIVIDE(SUM(Vehicle[Fatal]) + SUM(Vehicle[Serious]), SUM(Vehicle[Crashes]))
		formatString: 0.0%
		displayFolder: Conditions
		lineageTag: c62cdefd-7887-4a7c-982a-745637a2db9b

	measure 'Conditions Note' = IF(SELECTEDVALUE(StudyContext[Study Context]) = "India Bengaluru Corridors", "The Bengaluru feed has no weather, surface or lighting fields, so the environmental charts are UK-only. The vehicle chart below shows corridor types.", "Vehicle chart groups UK crashes by posted speed limit. Switch Study Context to see Bengaluru corridor types.")
		displayFolder: Labels
		lineageTag: b594e466-4430-44b5-ac30-3e3970c0bb42

	measure 'UK Map X' = CALCULATE(AVERAGE(Segments[Mid Lon]), KEEPFILTERS(Segments[Study Context] = "UK STATS19 Network"))
		formatString: 0.0000
		displayFolder: Map
		lineageTag: 5de9bbcb-f7ab-45f3-b8c2-41529f1bf753

	measure 'UK Map Y' = CALCULATE(AVERAGE(Segments[Map Y]), KEEPFILTERS(Segments[Study Context] = "UK STATS19 Network"))
		formatString: 0.000000
		displayFolder: Map
		lineageTag: 3317d5bb-d1e7-4537-a30b-d563f4f38308

	measure 'UK Map Risk' = CALCULATE([Mean Exposure Risk], KEEPFILTERS(Segments[Study Context] = "UK STATS19 Network"))
		formatString: 0.00
		displayFolder: Map
		lineageTag: 1eae9294-4cc3-4bac-9f5c-f082f7b78f08

	measure 'India Map X' = CALCULATE(AVERAGE(Segments[Mid Lon]), KEEPFILTERS(Segments[Study Context] = "India Bengaluru Corridors"))
		formatString: 0.0000
		displayFolder: Map
		lineageTag: ba706e57-8edd-436b-b7bd-21f5008ef9d4

	measure 'India Map Y' = CALCULATE(AVERAGE(Segments[Map Y]), KEEPFILTERS(Segments[Study Context] = "India Bengaluru Corridors"))
		formatString: 0.000000
		displayFolder: Map
		lineageTag: 3f0de49b-b32d-4e15-b776-cb0f84c50c5e

	measure 'India Map Risk' = CALCULATE([Mean Exposure Risk], KEEPFILTERS(Segments[Study Context] = "India Bengaluru Corridors"))
		formatString: 0.00
		displayFolder: Map
		lineageTag: 52a6640f-f824-48b8-949c-a53136f344a3

	measure 'India Risk' = CALCULATE([Mean Exposure Risk], KEEPFILTERS(Segments[Study Context] = "India Bengaluru Corridors"))
		formatString: 0.00
		displayFolder: India
		lineageTag: 0cba46a7-e00d-4a6c-83bc-0af14b5a8f78

	measure 'India AADT' = CALCULATE(SUM(Segments[AADT]), KEEPFILTERS(Segments[Study Context] = "India Bengaluru Corridors"))
		formatString: #,0
		displayFolder: India
		lineageTag: 82c27d46-7226-45c9-9fcf-c325076e195e

	measure 'India Length km' = CALCULATE(SUM(Segments[Length km]), KEEPFILTERS(Segments[Study Context] = "India Bengaluru Corridors"))
		formatString: 0.0
		displayFolder: India
		lineageTag: fe04dd3b-6398-44b3-9217-2a341158ac40

	measure 'India Two-Wheeler Share' = CALCULATE(AVERAGE(Segments[Two-Wheeler Share]), KEEPFILTERS(Segments[Study Context] = "India Bengaluru Corridors"))
		formatString: 0%
		displayFolder: India
		lineageTag: 754b8b40-ee44-4995-9051-e76837d39ffd

	measure 'India Crashes' = CALCULATE([Total Crashes], KEEPFILTERS(Segments[Study Context] = "India Bengaluru Corridors"))
		formatString: #,0
		displayFolder: India
		lineageTag: 5e104c9b-07b7-45c6-9320-b98852867427

	measure 'India Fatalities' = CALCULATE([Total Fatalities], KEEPFILTERS(Segments[Study Context] = "India Bengaluru Corridors"))
		formatString: #,0
		displayFolder: India
		lineageTag: 7bcae5d8-7548-4583-ae67-dbc659db490d

	measure 'India VRU Crashes' = CALCULATE(SUM(Segments[VRU Crashes]), KEEPFILTERS(Segments[Study Context] = "India Bengaluru Corridors"))
		formatString: #,0
		displayFolder: India
		lineageTag: 00a3a7a9-f925-43fa-a37d-74d3ef6803b6

	measure 'India Exposure' = CALCULATE([Network Exposure (MVKM)], KEEPFILTERS(Segments[Study Context] = "India Bengaluru Corridors"))
		formatString: #,0.00
		displayFolder: India
		lineageTag: 55726e98-bb38-4118-94d7-0f58ebc9428d

	measure 'Feature Importance' = SUM(Features[Importance])
		formatString: 0.0000
		displayFolder: ML
		lineageTag: 3290d4d5-9a36-4af2-8d7f-d9cf84105f87

	measure 'Simulated Severe Probability' = VAR s = SELECTEDVALUE(SimSpeed[Speed Limit (mph)], 60) VAR night = SELECTEDVALUE(SimTime[Time of Day], "Daylight") = "Dark Night" VAR unlit = SELECTEDVALUE(SimLighting[Lighting Infrastructure], "Lit by Streetlights") = "Unlit (Zero Lighting)" VAR w = SELECTEDVALUE(SimWeather[Weather Condition], "Clear / Fine") VAR vru = SELECTEDVALUE(SimRoadUser[Road User], "Vulnerable (Motorcycle / Bicycle)") = "Vulnerable (Motorcycle / Bicycle)" VAR r = 0.08 + IF(s >= 60, 0.22, IF(s >= 40, 0.10, 0)) + IF(night, 0.15, 0) + IF(unlit, 0.25, 0) + IF(CONTAINSSTRING(w, "Rain"), 0.10, IF(CONTAINSSTRING(w, "Fog"), 0.18, 0)) + IF(vru, 0.20, 0) RETURN MIN(0.96, MAX(0.04, r))
		formatString: 0.0%
		displayFolder: ML
		lineageTag: 251be277-9326-4c10-8595-19319bbece5d

	measure 'Simulated vs Network' = VAR d = [Simulated Severe Probability] - 0.25 RETURN FORMAT(d, "+0.0%;-0.0%") & " vs network average (25%)"
		displayFolder: ML
		lineageTag: 90eb1fc8-44a3-4608-94fa-54a1f00890e4

	measure 'Simulated Rating' = VAR p = [Simulated Severe Probability] RETURN SWITCH(TRUE(), p > 0.5, "HIGH RISK: immediate engineering intervention. Install LED street lighting, automated speed cameras and anti-skid high-friction surfacing.", p > 0.25, "MODERATE RISK: add advisory electronic speed signs and reflective road studs.", "LOW RISK: within tolerable network safety thresholds.")
		displayFolder: ML
		lineageTag: eb005bdc-be0e-4815-a8f0-36e8174d7afa

	column Column1
		dataType: string
		isHidden
		lineageTag: 2cd84b06-279e-4245-9178-583b34726a31
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t])
				in
				    Source

	annotation PBI_ResultType = Table
