table SimTime
	lineageTag: 7c4ead79-d63c-483f-ad8b-5d303a17fd24

	column 'Time of Day'
		dataType: string
		lineageTag: eb2aad9b-8364-4f5a-be11-836c5babc13a
		summarizeBy: none
		sortByColumn: 'Time Order'
		sourceColumn: Time of Day

		annotation SummarizationSetBy = User

	column 'Time Order'
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 73c4a4a1-5762-4f5d-8ece-59ae6ef8020c
		summarizeBy: none
		sourceColumn: Time Order

		annotation SummarizationSetBy = User

	partition SimTime = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "SimTime.csv"),[Delimiter=",", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers,{{"Time of Day", type text}, {"Time Order", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
