table Features
	lineageTag: 664c3183-1999-4bea-9f77-98ef1eae2a45

	column Feature
		dataType: string
		lineageTag: c997f684-992b-418f-be7f-3560c5d19bba
		summarizeBy: none
		sourceColumn: Feature

		annotation SummarizationSetBy = User

	column Importance
		dataType: double
		formatString: 0.0000
		lineageTag: 969087ca-6b37-4129-8110-2b86d43ac994
		summarizeBy: none
		sourceColumn: Importance

		annotation SummarizationSetBy = User

	partition Features = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Features.csv"),[Delimiter=",", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers,{{"Feature", type text}, {"Importance", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
